# Copy to .env and fill in. Never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://skill_cortex:skill_cortex@localhost:5432/skill_cortex
TEST_DATABASE_URL=postgresql+psycopg://skill_cortex:skill_cortex@localhost:5432/skill_cortex_test
TIMEZONE=Asia/Kolkata
BOOKING_HOLD_MINUTES=15
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Abuse protection (production refuses to start with rate limiting off)
RATE_LIMIT_ENABLED=true
MAX_REQUEST_BODY_BYTES=1000000

# Auth — JWT_SECRET must be 32+ random characters in production
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# Razorpay (Phase 6)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications — "console" just logs messages (development)
EMAIL_PROVIDER=console          # console | smtp
SMS_PROVIDER=console            # console | msg91
NOTIFICATION_MAX_ATTEMPTS=3

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@skillcortex.local
EMAIL_FROM_NAME=Skill Cortex

# MSG91 flow API: one DLT-approved template id per message type
MSG91_AUTH_KEY=
MSG91_TEMPLATE_BOOKING_CONFIRMATION=
MSG91_TEMPLATE_ADMIN_PAYMENT=
MSG91_TEMPLATE_CANCELLATION=
MSG91_TEMPLATE_REFUND=
MSG91_TEMPLATE_REMINDER=

# Comma-separated admin recipients for payment notifications
ADMIN_NOTIFY_EMAILS=
ADMIN_NOTIFY_PHONES=

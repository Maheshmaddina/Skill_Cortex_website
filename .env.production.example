# Copy to .env.production on the server (never commit it) and fill in every value.

# --- Site & TLS -------------------------------------------------------------------
DOMAIN=skillcortex.example.com
ACME_EMAIL=admin@example.com          # required: Let's Encrypt account / expiry notices
CONTACT_EMAIL=info@skillcortexai.com    # shown in the site footer

# --- Database (use URL-safe characters: openssl rand -hex 24) ---------------------
POSTGRES_USER=skill_cortex
POSTGRES_DB=skill_cortex
POSTGRES_PASSWORD=

# --- API --------------------------------------------------------------------------
APP_ENV=production
JWT_SECRET=                            # openssl rand -hex 48
FRONTEND_URL=https://skillcortex.example.com
CORS_ORIGINS=https://skillcortex.example.com
COOKIE_SECURE=true
REFRESH_COOKIE_PATH=/api/auth          # the API is served under /api
WEB_CONCURRENCY=2                      # uvicorn workers (≈ CPU cores)
TIMEZONE=Asia/Kolkata
BOOKING_HOLD_MINUTES=15
RATE_LIMIT_ENABLED=true

# --- Razorpay (live keys only when you're ready to take real payments) -----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=               # webhook URL: https://<DOMAIN>/api/payments/webhook

# --- Email ------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@skillcortex.example.com
EMAIL_FROM_NAME=Skill Cortex

# --- SMS (MSG91 with DLT-approved templates; or SMS_PROVIDER=console to disable) -
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_BOOKING_CONFIRMATION=
MSG91_TEMPLATE_ADMIN_PAYMENT=
MSG91_TEMPLATE_CANCELLATION=
MSG91_TEMPLATE_REFUND=
MSG91_TEMPLATE_REMINDER=

# --- Admin alerts for verified payments -------------------------------------------
ADMIN_NOTIFY_EMAILS=
ADMIN_NOTIFY_PHONES=
